# Note: the app code reads VITE_API_BASE (not VITE_API_URL) via
# import.meta.env.VITE_API_BASE — leave unset in local dev to use
# Vite's dev proxy (see vite.config.ts, which targets localhost:5000).
VITE_API_BASE=

# Must match GOOGLE_CLIENT_ID in server/.env — same Google OAuth client.
VITE_GOOGLE_CLIENT_ID=
