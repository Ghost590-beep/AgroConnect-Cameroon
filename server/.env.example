# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=agroconnect
DB_USER=root
DB_PASSWORD=

# Server
PORT=5000
SERVER_PORT=5000
NODE_ENV=development

# Auth
JWT_SECRET=
# Must match VITE_GOOGLE_CLIENT_ID in client/.env — same Google OAuth client,
# or the ID-token audience check will always fail.
GOOGLE_CLIENT_ID=
